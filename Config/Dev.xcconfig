// Dev.xcconfig
// Base build settings for the Dev configuration of the Attnd, AttndAppClip and AttndWidgets targets.
//
// Dev is a copy of Debug (the DEBUG and DEV Swift conditions, assertions on, dSYMs kept) but optimised for
// size like Release (-Osize, C -Os, no testability; Nov 19, 2026 owner: the App Clip must stay under Apple's
// 15 MB limit in TestFlight builds too). CI archives it for pushes to develop, distribution-signed, against
// the dev server (ATTND_SERVER=dev.attnd.app on the command line). main archives Release.
// DEV turns on continuous log upload (AppLog.swift). Same keys and SDK flags as Debug.

#include "Debug.xcconfig"
