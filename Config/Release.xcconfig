// Release.xcconfig
// Base build settings for the Release configuration of the Attnd and AttndAppClip targets.
//
// Production builds authenticate with App Attest, so ATTND_API_KEY is empty by default.
// CI can still inject a key (e.g. for test runs) through Config/Secrets.xcconfig
// or on the command line: xcodebuild ... ATTND_API_KEY=$ATTND_API_KEY

ATTND_API_KEY =

// API host (no scheme — "//" starts a comment in xcconfig). CI sets this to the Heroku dev
// app for builds from the develop branch, e.g. ATTND_SERVER=attnd-dev-7ab893f37020.herokuapp.com
ATTND_SERVER = attnd.app

#include? "Secrets.xcconfig"

// iPhone Duo APIs need the iOS 27.1+ SDK (Xcode 27.1+); see FoldableLayout.swift. 27.0 is excluded.
OTHER_SWIFT_FLAGS[sdk=iphoneos27.1*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos27.2*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos27.3*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos27.4*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos27.5*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos27.6*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos27.7*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos27.8*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos27.9*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos28*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos29*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27.1*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27.2*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27.3*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27.4*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27.5*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27.6*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27.7*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27.8*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27.9*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator28*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator29*] = $(inherited) -DIOS27_SDK
