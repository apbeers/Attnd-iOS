// Secrets.xcconfig.example
// Copy to Config/Secrets.xcconfig (gitignored) and fill in your development key:
//
//   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//
// Debug.xcconfig and Release.xcconfig include it optionally, so builds work without it
// (they just fall back to App Attest, which needs a real device).

ATTND_API_KEY = your_dev_key_here
