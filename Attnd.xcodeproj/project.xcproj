        "CURRENT_PROJECT_VERSION": "44",
        "DEVELOPMENT_ASSET_PATHS": "\"Attnd/Preview Content\"",
        "DEVELOPMENT_TEAM": "GQQX4L6TE2",
        "ENABLE_PREVIEWS": "YES",
        "INFOPLIST_FILE": "Attnd/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Attnd",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.entertainment",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0.44",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.arcu.Attnd",
        "PRODUCT_NAME": "Attnd",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
