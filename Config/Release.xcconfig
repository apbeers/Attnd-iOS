// Release.xcconfig
// Base build settings for the Release configuration of the Attnd and AttndAppClip targets.
//
// Production builds authenticate with App Attest, so ATTND_API_KEY is empty by default.
// CI can still inject a key (e.g. for test runs) through Config/Secrets.xcconfig
// or on the command line: xcodebuild ... ATTND_API_KEY=$ATTND_API_KEY

ATTND_API_KEY =

// API host (no scheme — "//" starts a comment in xcconfig). CI sets this to the Heroku dev
// app for builds from the develop branch, e.g. ATTND_SERVER=attnd-dev-7ab893f37020.herokuapp.com
ATTND_SERVER = attnd.app

#include? "Secrets.xcconfig"

// iPhone Duo / iOS 27 APIs are compiled only against the iOS 27+ SDK (see FoldableLayout.swift).
OTHER_SWIFT_FLAGS[sdk=iphoneos27*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator27*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphoneos28*] = $(inherited) -DIOS27_SDK
OTHER_SWIFT_FLAGS[sdk=iphonesimulator28*] = $(inherited) -DIOS27_SDK
