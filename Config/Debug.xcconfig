// Debug.xcconfig
// Base build settings for the Debug configuration of the Attnd and AttndAppClip targets.
//
// ATTND_API_KEY is the static API key used by simulators, CI and dev builds where
// App Attest is unavailable. It is empty by default and must NEVER be committed.
// Put your key in Config/Secrets.xcconfig (gitignored), see Secrets.xcconfig.example,
// or pass it on the command line: xcodebuild ... ATTND_API_KEY=your_key

ATTND_API_KEY =

// API host (no scheme — "//" starts a comment in xcconfig). CI sets this to the Heroku dev
// app for builds from the develop branch, e.g. ATTND_SERVER=attnd-dev.herokuapp.com
ATTND_SERVER = attnd.app

#include? "Secrets.xcconfig"
